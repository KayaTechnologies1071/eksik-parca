# EKSİK PARÇA (THE MISSING PIECE) — ÜRETİM ORTAM DEĞİŞKENLERİ ŞABLONU

# 1. Sunucu Portu (Railway / Render otomatik atar, yerelde 3001)
PORT=3001

# 2. Kalıcı PostgreSQL Veritabanı Bağlantısı (Supabase Projesi: dedektifgame / zioqzlzhvdvxddwsnhem)
# Boş bırakılırsa yerel geliştirme için otomatik olarak database/db.json kullanılır.
# Supabase Dashboard -> Connect -> Transaction Pooler / Session Pooler üzerinden aldığınız bağlantı dizesi:
DATABASE_URL=postgresql://postgres.zioqzlzhvdvxddwsnhem:VERITABANI_SIFRENIZ@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# 3. Supabase API Bilgileri (İsteğe bağlı istemci/analitik entegrasyonu için)
SUPABASE_URL=https://zioqzlzhvdvxddwsnhem.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_joStnu-DeBMXTCoEtoUhMQ_0jMWxrZ2

# 4. Bellek İçi Oda Önbelleği (İsteğe bağlı çoklu sunucu ölçekleme için Redis URL)
REDIS_URL=redis://default:SIFRENIZ@redis.railway.internal:6379

# 5. Mobil APK ve Web İstemci Derlemesi İçin Canlı Sunucu Adresi
# Android APK almadan önce canlı Railway/Render adresinizi buraya yazabilirsiniz:
VITE_API_BASE_URL=https://eksik-parca-production.up.railway.app
